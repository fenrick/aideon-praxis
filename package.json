{
  "name": "aideon-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Aideon — a desktop-first, local-first, time-first digital-twin app (Tauri + Next.js)",
  "packageManager": "pnpm@11.6.0",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "node:dev": "next dev -p 1420",
    "node:build": "next build",
    "preview": "pnpm dlx serve out -l 4173",
    "node:lint": "eslint --cache --cache-location .eslintcache --max-warnings=10 \"src/**/*.{ts,tsx,js}\" \"tests/**/*.{ts,tsx,js}\"",
    "node:lint:fix": "eslint --cache --cache-location .eslintcache --max-warnings=10 \"src/**/*.{ts,tsx,js}\" \"tests/**/*.{ts,tsx,js}\" --fix",
    "node:typecheck": "tsc --noEmit",
    "node:format": "prettier -w .",
    "node:format:check": "prettier -c .",
    "node:test": "vitest run --reporter=default",
    "node:test:coverage": "vitest run --coverage.enabled=true --coverage.provider=istanbul --coverage.reporter=lcov --coverage.reporter=html --coverage.reporter=text",
    "host:format": "cargo fmt --all",
    "host:format:check": "cargo fmt --all -- --check",
    "host:lint": "cargo clippy --all-targets -- -D warnings",
    "host:check": "cargo check --all-targets --all-features",
    "host:fix": "cargo fix --allow-dirty",
    "host:build": "cargo build --workspace",
    "host:test": "cargo test --all --quiet",
    "host:audit": "cargo audit -D warnings",
    "host:coverage": "SYSROOT=$(rustc --print sysroot); HOST=$(rustc -vV | sed -n 's/^host: //p'); LLVM_COV=$SYSROOT/lib/rustlib/$HOST/bin/llvm-cov; LLVM_PROFDATA=$SYSROOT/lib/rustlib/$HOST/bin/llvm-profdata; if [ ! -x \"$LLVM_COV\" ] || [ ! -x \"$LLVM_PROFDATA\" ]; then LLVM_COV=$(xcrun --find llvm-cov 2>/dev/null || true); LLVM_PROFDATA=$(xcrun --find llvm-profdata 2>/dev/null || true); fi; if [ ! -x \"$LLVM_COV\" ] || [ ! -x \"$LLVM_PROFDATA\" ]; then echo \"Missing llvm-cov/llvm-profdata; install llvm-tools-preview or Xcode CLT.\"; exit 1; fi; LLVM_COV=$LLVM_COV LLVM_PROFDATA=$LLVM_PROFDATA cargo llvm-cov --workspace --all-features --lcov --output-path coverage/rust.lcov",
    "host:clean": "cargo clean",
    "node:ci": "pnpm run design:guard && pnpm run node:lint && pnpm run node:typecheck && pnpm run node:test && pnpm run node:format:check",
    "host:ci": "pnpm run host:format:check && pnpm run host:lint && pnpm run host:check && pnpm run host:test",
    "ci": "pnpm run node:ci && pnpm run host:ci",
    "design:guard": "node tools/design-system-guard.mjs",
    "preflight": "node tools/preflight.mjs",
    "components:refresh": "pnpm dlx shadcn@latest add --all --overwrite --yes && pnpm dlx shadcn@latest add @reactflow/node-search @reactflow/base-node @reactflow/node-tooltip @reactflow/animated-svg-edge @reactflow/node-status-indicator @reactflow/node-appendix @reactflow/placeholder-node @reactflow/labeled-group-node @reactflow/base-handle @reactflow/labeled-handle @reactflow/button-handle @reactflow/button-edge @reactflow/data-edge @reactflow/zoom-slider @reactflow/zoom-select @reactflow/devtools --overwrite --yes",
    "node:e2e": "node tests/e2e/run.mjs",
    "webdriver:test": "wdio run tests/webdriver/wdio.conf.js",
    "webdriver:test:headless": "xvfb-run -a wdio run tests/webdriver/wdio.conf.js",
    "release": "semantic-release",
    "commitlint": "commitlint --from=origin/main --to=HEAD",
    "test:stories": "vitest run --config vitest.storybook.config.mjs",
    "prepare": "husky"
  },
