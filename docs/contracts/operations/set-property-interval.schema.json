{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aideon.dev/contracts/operations/set-property-interval.schema.json",
  "title": "SetPropIntervalInput",
  "description": "Set a typed property value over a valid-time interval on a slot. Field names and types match crates/mneme_core/src/ops.rs::SetPropIntervalInput (command mneme_store_set_property_interval). Op kind: SetProperty (op_type 4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "partition",
    "actor",
    "asserted_at",
    "entity_id",
    "field_id",
    "value",
    "valid_from",
    "layer"
  ],
  "properties": {
    "partition": { "$ref": "#/$defs/id" },
    "scenario_id": { "$ref": "#/$defs/idOrNull" },
    "actor": { "$ref": "#/$defs/id" },
    "asserted_at": { "$ref": "#/$defs/hlc" },
    "entity_id": { "$ref": "#/$defs/id", "description": "Entity instance the slot belongs to." },
    "field_id": {
      "$ref": "#/$defs/id",
      "description": "Attribute symbol UUID (UUIDv5), e.g. disposition."
    },
    "value": { "$ref": "#/$defs/value" },
    "valid_from": {
      "$ref": "#/$defs/validTime",
      "description": "Interval start, epoch microseconds UTC."
    },
    "valid_to": {
      "$ref": "#/$defs/validTimeOrNull",
      "description": "Interval end (half-open); null for open-ended."
    },
    "layer": { "$ref": "#/$defs/layer" },
    "write_options": { "$ref": "#/$defs/writeOptions" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "idOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "hlc": { "type": "integer" },
    "validTime": { "type": "integer" },
    "validTimeOrNull": { "type": ["integer", "null"] },
    "layer": { "type": "string", "enum": ["Plan", "Actual"] },
    "value": {
      "type": "object",
      "description": "Value enum, externally-tagged serde representation: exactly one variant key. Str|I64|F64|Bool|Time|Ref|Blob|Json.",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "Str": { "type": "string" },
        "I64": { "type": "integer" },
        "F64": { "type": "number" },
        "Bool": { "type": "boolean" },
        "Time": { "type": "integer", "description": "ValidTime as epoch microseconds UTC." },
        "Ref": { "$ref": "#/$defs/id" },
        "Blob": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "description": "Byte array; large blobs are content-addressed, not inlined."
        },
        "Json": { "description": "Arbitrary JSON value." }
      }
    },
    "writeOptions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": { "bulk_mode": { "type": "boolean" } }
    }
  }
}
