{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aideon.dev/contracts/operations/clear-property-interval.schema.json",
  "title": "ClearPropIntervalInput",
  "description": "Clear a typed property value over a valid-time interval (closes a prior open-ended claim). Field names and types match crates/mneme_core/src/ops.rs::ClearPropIntervalInput (command mneme_store_clear_property_interval). Op kind: ClearProperty (op_type 5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["partition", "actor", "asserted_at", "entity_id", "field_id", "valid_from", "layer"],
  "properties": {
    "partition": { "$ref": "#/$defs/id" },
    "scenario_id": { "$ref": "#/$defs/idOrNull" },
    "actor": { "$ref": "#/$defs/id" },
    "asserted_at": { "$ref": "#/$defs/hlc" },
    "entity_id": { "$ref": "#/$defs/id" },
    "field_id": { "$ref": "#/$defs/id" },
    "valid_from": { "$ref": "#/$defs/validTime" },
    "valid_to": { "$ref": "#/$defs/validTimeOrNull" },
    "layer": { "$ref": "#/$defs/layer" },
    "write_options": { "$ref": "#/$defs/writeOptions" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "idOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "hlc": { "type": "integer" },
    "validTime": { "type": "integer" },
    "validTimeOrNull": { "type": ["integer", "null"] },
    "layer": { "type": "string", "enum": ["Plan", "Actual"] },
    "writeOptions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": { "bulk_mode": { "type": "boolean" } }
    }
  }
}
