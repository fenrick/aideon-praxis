{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aideon.dev/contracts/operations/set-edge-existence-interval.schema.json",
  "title": "SetEdgeExistenceIntervalInput",
  "description": "Modify an edge's existence interval without changing its endpoints; may carry a tombstone flag. Field names and types match crates/mneme_core/src/ops.rs::SetEdgeExistenceIntervalInput. Op kind: SetEdgeExistenceInterval (op_type 11).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "partition",
    "actor",
    "asserted_at",
    "edge_id",
    "valid_from",
    "layer",
    "is_tombstone"
  ],
  "properties": {
    "partition": { "$ref": "#/$defs/id" },
    "scenario_id": { "$ref": "#/$defs/idOrNull" },
    "actor": { "$ref": "#/$defs/id" },
    "asserted_at": { "$ref": "#/$defs/hlc" },
    "edge_id": { "$ref": "#/$defs/id" },
    "valid_from": { "$ref": "#/$defs/validTime" },
    "valid_to": { "$ref": "#/$defs/validTimeOrNull" },
    "layer": { "$ref": "#/$defs/layer" },
    "is_tombstone": {
      "type": "boolean",
      "description": "When true, suppresses the edge from this valid_from within its layer (supersession, not erasure)."
    },
    "write_options": { "$ref": "#/$defs/writeOptions" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "idOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "hlc": { "type": "integer" },
    "validTime": { "type": "integer" },
    "validTimeOrNull": { "type": ["integer", "null"] },
    "layer": { "type": "string", "enum": ["Plan", "Actual"] },
    "writeOptions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": { "bulk_mode": { "type": "boolean" } }
    }
  }
}
