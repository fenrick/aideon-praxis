{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aideon.dev/contracts/operations/upsert-metamodel-batch.schema.json",
  "title": "UpsertMetamodelBatch payload",
  "description": "Typed payload for the upsert-metamodel-batch operation kind (registry code 8). A batch type/field/rule schema update stored as schema-as-data. The payload shape here is the canonical contract for this op kind; the implementation is built to it. Encoded per the canonical-JSON profile: all fields present, absent optionals as null, empty collections as [], UUIDs lower-case hyphenated, enum and value tags as stable schema-owned lower names. A published metamodel_version is immutable; a change appends a new batch with a higher version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "types",
    "fields",
    "type_fields",
    "edge_type_rules",
    "validation",
    "metamodel_version",
    "metamodel_source"
  ],
  "properties": {
    "types": { "type": "array", "items": { "$ref": "#/$defs/typeDef" } },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/fieldDef" } },
    "type_fields": { "type": "array", "items": { "$ref": "#/$defs/typeFieldDef" } },
    "edge_type_rules": { "type": "array", "items": { "$ref": "#/$defs/edgeTypeRule" } },
    "validation": { "$ref": "#/$defs/validationRules" },
    "metamodel_version": { "type": ["string", "null"] },
    "metamodel_source": { "type": ["string", "null"] }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "idOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entityKind": {
      "type": "string",
      "enum": ["node", "edge"],
      "description": "EntityKind value tag as a stable schema-owned lower name."
    },
    "valueType": {
      "type": "string",
      "enum": ["str", "i64", "f64", "bool", "time", "ref", "blob"],
      "description": "ValueType value tag as a stable schema-owned lower name. `json` is not a declarable field type (ADR-0038); an opaque document is a `blob` BlobRef."
    },
    "fieldKind": {
      "type": "string",
      "enum": ["string", "text", "number", "enum", "datetime", "boolean", "blob"],
      "description": "Authored semantic kind. Richer than valueType: string/text/enum all store as `str` but validate and compile differently. Drives the M1 effective-schema slot descriptor (max_length, enum variants, datetime format)."
    },
    "validationRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["string_max_length", "text_max_length", "enum_case_sensitive"],
      "description": "Global attribute validation rules, carried so the effective schema is op-log-rebuildable. Length caps are character counts (small integers, JSON numbers); null = uncapped.",
      "properties": {
        "string_max_length": { "type": ["integer", "null"], "minimum": 0 },
        "text_max_length": { "type": ["integer", "null"], "minimum": 0 },
        "enum_case_sensitive": { "type": "boolean" }
      }
    },
    "value": {
      "type": "object",
      "description": "Value tag: an object with exactly one stable schema-owned lower variant key. str|i64|f64|bool|time|ref|blob. `json` is NOT a valid value (ADR-0038); opaque documents are BlobRefs.",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "str": { "type": "string" },
        "i64": { "type": "string", "pattern": "^-?[0-9]+$" },
        "f64": { "type": "number" },
        "bool": { "type": "boolean" },
        "time": { "type": "string", "pattern": "^-?[0-9]+$" },
        "ref": { "$ref": "#/$defs/id" },
        "blob": { "$ref": "#/$defs/blobRef" }
      }
    },
    "blobRef": {
      "type": "object",
      "description": "Typed content-addressed reference; bytes live in objects/sha256/, never inlined. media_type present as null when absent.",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "length", "media_type"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "length": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Byte length as a constrained decimal string (full-range u64, per the canonical-JSON profile)."
        },
        "media_type": { "type": ["string", "null"] }
      }
    },
    "typeDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id",
        "key",
        "applies_to",
        "label",
        "category",
        "effect_types",
        "is_abstract",
        "parent_type_id"
      ],
      "properties": {
        "type_id": { "$ref": "#/$defs/id" },
        "key": {
          "type": "string",
          "description": "Stable domain string id (never changes); the effective-schema/registry key."
        },
        "applies_to": { "$ref": "#/$defs/entityKind" },
        "label": { "type": "string" },
        "category": {
          "type": ["string", "null"],
          "description": "Authored classification, e.g. Business/Application."
        },
        "effect_types": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Plan-effect verbs the type declares (PlanEvent only in the seed)."
        },
        "is_abstract": { "type": "boolean" },
        "parent_type_id": {
          "$ref": "#/$defs/idOrNull",
          "description": "Single-inheritance parent; cycles rejected before accept."
        }
      }
    },
    "fieldDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "key",
        "label",
        "value_type",
        "semantic_kind",
        "enum_values",
        "cardinality_multi",
        "is_indexed"
      ],
      "properties": {
        "field_id": { "$ref": "#/$defs/id" },
        "key": {
          "type": "string",
          "description": "Stable domain string id (the attribute name); the effective-schema slot key."
        },
        "label": { "type": "string" },
        "value_type": { "$ref": "#/$defs/valueType" },
        "semantic_kind": { "$ref": "#/$defs/fieldKind" },
        "enum_values": { "type": "array", "items": { "type": "string" } },
        "cardinality_multi": { "type": "boolean" },
        "is_indexed": { "type": "boolean" }
      }
    },
    "typeFieldDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id",
        "field_id",
        "is_required",
        "default_value",
        "override_default",
        "tighten_required"
      ],
      "properties": {
        "type_id": { "$ref": "#/$defs/id" },
        "field_id": { "$ref": "#/$defs/id" },
        "is_required": { "type": "boolean" },
        "default_value": { "oneOf": [{ "$ref": "#/$defs/value" }, { "type": "null" }] },
        "override_default": { "type": "boolean" },
        "tighten_required": { "type": "boolean" }
      }
    },
    "edgeTypeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_type_id",
        "allowed_src_type_ids",
        "allowed_dst_type_ids",
        "semantic_direction"
      ],
      "properties": {
        "edge_type_id": { "$ref": "#/$defs/id" },
        "allowed_src_type_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "allowed_dst_type_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "semantic_direction": { "type": ["string", "null"] }
      }
    }
  }
}
